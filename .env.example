DATABASE_URL=sqlite:///./data/incident.db
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL
ESCALATION_TIMEOUT_MINUTES=10

# ── AI 調査エージェント ────────────────────────────────────────────────────

# AI エージェントを無効化する場合は false に設定（デフォルト: true）
# AI_ENABLED=false

# "openai" / "ollama" のいずれかを指定
# LLM_PROVIDER=openai

# OpenAI
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini

# Ollama（ローカルLLM）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# RAG ベクターストアの保存先
# AI_RAG_PATH=.chromadb

# キャッシュ有効期間（日数）
# AI_CACHE_TTL_DAYS=7

# topology-syslog の URL（設定するとインシデント詳細を取得してレポートに活用）
# TOPOLOGY_SYSLOG_URL=http://topology-syslog:8080
